# 默认连接本机；LAN 每次重新开放后，请核对聊天栏公布的端口。
MC_HOST=127.0.0.1
# 必填：请填写本次 Open to LAN 的实际端口，不要照搬示例端口。
MC_PORT=

# microsoft（默认）：浏览器设备代码登录，目标需要正常正版认证时使用。
# offline：仅在目标本来就允许离线连接时显式选择，不会绕过服务器认证。
MC_AUTH=microsoft

# microsoft：用于区分账号缓存的稳定标识，不是任意指定的游戏昵称。
# 首次浏览器登录请选择 Bot 专用的、拥有 Java Edition 权限的账号。
# offline：Bot 的游戏昵称，限 3–16 位英文字母、数字、下划线，且不同于玩家昵称。
BOT_USERNAME=MineMate

# 可选：填写控制 Bot 移动的玩家游戏昵称（不是 Microsoft 邮箱）。
# 留空时允许所有玩家控制移动；填写后只有该玩家可以跟随、前往或停止。
OWNER_USERNAME=

# 三个独立限制；距离/搜索范围为 1–4096，搜索时限为 1–60000 毫秒。
# 超过目标距离限制只表示超出本次导航范围，不代表目标一定不可达。
PATHFINDER_MAX_DISTANCE=256
# 插件的搜索范围/代价限制参数，与上面的直线距离检查不同。
PATHFINDER_SEARCH_RADIUS=256
PATHFINDER_THINK_TIMEOUT_MS=5000

# 感知只读取 Mineflayer 已加载数据；半径与每次返回上限均有限制。
PERCEPTION_ENTITY_RADIUS=16
PERCEPTION_BLOCK_RADIUS=5
PERCEPTION_MAX_ENTITIES=32
PERCEPTION_MAX_BLOCKS=64
# 环境方块扫描缓存时长；Bot 位置变化、切换维度、死亡或断线也会刷新缓存。
PERCEPTION_BLOCK_CACHE_MS=1000

# Node.js HTTP API；Python Agent 通过此地址调用游戏控制层。
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
# 请求体上限，默认 16 KiB；只接受小型 JSON 控制请求。
HTTP_MAX_BODY_BYTES=16384

# 旧指令优先，其余玩家消息异步转发 Python；false 可关闭自然语言聊天。
AGENT_CHAT_ENABLED=true
AGENT_API_URL=http://127.0.0.1:8000
# Task 005：应比 LLM_TIMEOUT 略长；单位为毫秒。
# 启用 Task 006 时建议改为 120000，大于 Python 的 TOOL_CALLING_TIMEOUT=90 秒。
AGENT_TIMEOUT_MS=35000
AGENT_MAX_CONCURRENT=2
AGENT_REQUESTS_PER_MINUTE=20
AGENT_PLAYER_COOLDOWN_MS=3000

# 不要在此填写密码或访问令牌。Microsoft 模式会提示浏览器登录。
