# Python Agent 服务监听地址
AGENT_HOST=127.0.0.1
AGENT_PORT=8000

# Node.js MineMate HTTP API 地址；Python 不直接连接 Minecraft
NODE_API_URL=http://127.0.0.1:3000
NODE_API_TIMEOUT_SECONDS=5

# 兼容 OpenAI Chat Completions 的云端接口。Base URL 包含供应商要求的 /v1 前缀，
# 不要追加 /chat/completions；模型须支持 response_format=json_object 和 max_tokens。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# 填写你在供应商控制台可用的模型标识；未配置时只禁用自然语言处理。
LLM_MODEL=
LLM_TIMEOUT=30
# 单进程限额：无排队、无自动重试。
LLM_MAX_CONCURRENT=2
LLM_REQUESTS_PER_MINUTE=20
LLM_PLAYER_COOLDOWN=3

# Task 006：默认关闭以保留 Task 005 行为；确认供应商支持 function tools 后启用。
TOOL_CALLING_ENABLED=false
TOOL_MAX_CALLS=4
# 秒；Node 的 AGENT_TIMEOUT_MS 应大于整个循环时限。
TOOL_CALLING_TIMEOUT=90
TOOL_API_TIMEOUT=25
# 工具模式每轮输出预算（含供应商计入的推理 token），正整数，上限 8192。
# 增大可能增加费用和耗时；只在输出被截断时酌情调整，不自动重试。
TOOL_LLM_MAX_TOKENS=2048
