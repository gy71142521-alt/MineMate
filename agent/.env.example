# Python Agent 服务监听地址
AGENT_HOST=127.0.0.1
AGENT_PORT=8000

# Node.js MineMate HTTP API 地址；Python 不直接连接 Minecraft
NODE_API_URL=http://127.0.0.1:3000
NODE_API_TIMEOUT_SECONDS=5

# 兼容 OpenAI Chat Completions 的云端接口。Base URL 包含供应商要求的 /v1 前缀，
# 不要追加 /chat/completions；模型须支持 response_format=json_object 和 max_tokens。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# 填写你在供应商控制台可用的模型标识；未配置时只禁用自然语言处理。
LLM_MODEL=
LLM_TIMEOUT=30
# 单进程限额：无排队、无自动重试。
LLM_MAX_CONCURRENT=2
LLM_REQUESTS_PER_MINUTE=20
LLM_PLAYER_COOLDOWN=3

# Task 006：默认关闭以保留 Task 005 行为；确认供应商支持 function tools 后启用。
TOOL_CALLING_ENABLED=false
TOOL_MAX_CALLS=4
# 秒；Node 的 AGENT_TIMEOUT_MS 应大于整个循环时限。
TOOL_CALLING_TIMEOUT=90
TOOL_API_TIMEOUT=25
# 工具模式每轮输出预算（含供应商计入的推理 token），正整数，上限 8192。
# 增大可能增加费用和耗时；只在输出被截断时酌情调整，不自动重试。
TOOL_LLM_MAX_TOKENS=2048

# Planning 前置后台入口 /api/agent/tasks 不调用模型，不受上述消息循环时限控制。
# timeout_seconds、max_tool_calls、每步 wait_seconds 在请求中配置并受服务硬上限约束。
# 仅运行一个 Agent 进程，不使用 uvicorn 多 worker；默认 Node 租约 30 秒，Agent 每 5 秒续约。

# 服务端日志。LOG_LEVEL 可选 DEBUG/INFO/WARNING/ERROR；INFO 即可看到请求、工具结果和失败。
# LOG_TRACEBACK=none|errors|all：
#   none   只保留异常摘要；
#   errors 默认，未预期/基础设施异常打印脱敏堆栈；
#   all    连模型输出校验失败也打印堆栈，并附有界、脱敏的模型响应预览。
LOG_LEVEL=INFO
LOG_TRACEBACK=errors

# 记忆与上下文（Tool Calling 模式生效）。
# 事件日志和压缩摘要写入本地 SQLite；不要把该文件上传或提交 Git。
MEMORY_ENABLED=true
# 默认 data/minemate-memory.sqlite3（项目根目录）；相对路径按 Agent 进程工作目录解析。
MEMORY_DB_PATH=
MEMORY_CONTEXT_WINDOW=32768
MEMORY_COMPACTION_THRESHOLD=0.75
MEMORY_RETAIN_TURNS=6
MEMORY_MAX_SUMMARY_CHARS=4000
MEMORY_MAX_TOOL_RESULT_CHARS=4000
# 同一玩家超过该天数没有新消息时，下一条消息创建新会话；0 表示不按时间切分。
MEMORY_SESSION_IDLE_DAYS=30
MEMORY_AUTO_COMPACT=true
