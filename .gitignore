# 本地配置（保留无秘密的配置模板）
.env
.env.*
!.env.example
.idea

# 依赖、npm 缓存、运行日志
node_modules/
.npm-cache/
*.log

# Microsoft 登录缓存含敏感令牌，不得提交
.auth-cache/

# Python Agent 本地环境与缓存
__pycache__/
agent/.env
agent/.venv/
agent/**/__pycache__/
.pytest_cache/

.venv

# 本地记忆数据库包含玩家对话内容，不得提交
data/
agent/data/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
